# Copie para .env e ajuste os valores. O arquivo .env não vai para o Git.

# MLflow (dentro do docker-compose o host é "mlflow", fora dele é localhost)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=shopper-intent
REGISTERED_MODEL_NAME=shopper-intent-model
MODEL_ALIAS=champion

# Dados
DATA_RAW_PATH=data/raw/online_shoppers_intention.csv
